{
  "name": "cypress-poc-qaplayground",
  "version": "1.0.0",
  "description": "Cypress Cucumber POC for QA Playground",
  "author": "Shivani Rampally",
  "license": "ISC",
  "type": "commonjs",

  "scripts": {
    "cy:open": "cypress open",
    "cy:run": "cypress run --browser chrome --headed",

    "smoke": "cypress run --browser chrome --headed --spec \"cypress/e2e/smokeTest/**/*.feature\"",
    "regression": "cypress run --browser chrome --headed --spec \"cypress/e2e/regressionTest/**/*.feature\"",
    "e2e": "cypress run --browser chrome --headed --spec \"cypress/e2e/e2eFlow/**/*.feature\"",
    "all": "cypress run --browser chrome --headed",

    "report": "marge mochawesome-report/*.json -f report -o mochawesome-report",
    "test:report": "npm run all && npm run report"
  },

  "keywords": [
    "cypress",
    "cucumber",
    "automation",
    "qa-playground"
  ],

  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^24.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "cypress": "^15.18.0",
    "cypress-xpath": "^2.0.1",
    "esbuild": "^0.28.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2"
  }
}