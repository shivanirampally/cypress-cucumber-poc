{
  "name": "cypress-poc-qaplayground",
  "version": "1.0.0",
  "description": "Cypress Cucumber POC for QA Playground",
  "main": "index.js",
 "scripts": {
  "cy:open": "npx cypress open",
  "cy:run": "npx cypress run --headed --browser chrome",
  "smoke": "npx cypress run --headed --browser chrome --spec cypress/e2e/features/home.feature,cypress/e2e/features/bankPage.feature,cypress/e2e/features/transactionSmokeTest.feature",
  "regression": "npx cypress run --headed --browser chrome --spec cypress/e2e/features/login.feature,cypress/e2e/features/loginValidation.feature,cypress/e2e/features/javascriptConcepts.feature",
  "e2e": "npx cypress run --headed --browser chrome --spec cypress/e2e/features/secureBankE2E.feature",
  "report": "npx marge mochawesome-report/*.json -f report -o mochawesome-report",
  "test:report": "npx cypress run --headed --browser chrome && npx marge mochawesome-report/*.json -f report -o mochawesome-report"
},
  "keywords": [
    "cypress",
    "cucumber",
    "automation",
    "qa-playground"
  ],
  "author": "Shivani Rampally",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^24.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "cypress": "^15.18.0",
    "cypress-xpath": "^2.0.1",
    "esbuild": "^0.28.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2"
  }
}
