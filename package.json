{
  "name": "cypress-poc-qaplayground",
  "version": "1.0.0",
  "description": "Cypress Cucumber POC for QA Playground",
  "main": "index.js",
"scripts": {
  "cy:open": "cypress open",
  "cy:run": "cypress run --headed --browser chrome",
  "smoke": "cypress run --headed --browser chrome --env tags=@smoke",
  "smokeTest": "cypress run --headed --browser chrome --spec 'cypress/e2e/features/smokeTest.feature'",  
  "regression": "cypress run --headed --browser chrome --env tags=@regression",
  "e2e": "cypress run --headed --browser chrome --env tags=@e2e",
  "report": "marge mochawesome-report/*.json -f report -o mochawesome-report",
  "test:report": "cypress run --headed --browser chrome && marge mochawesome-report/*.json -f report -o mochawesome-report"
},
  "keywords": [
    "cypress",
    "cucumber",
    "automation",
    "qa-playground"
  ],
  "author": "Shivani Rampally",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@badeball/cypress-cucumber-preprocessor": "^24.0.1",
    "@bahmutov/cypress-esbuild-preprocessor": "^2.2.8",
    "cypress": "^15.18.0",
    "cypress-xpath": "^2.0.1",
    "esbuild": "^0.28.1",
    "mochawesome": "^7.1.4",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2"
  }
}
